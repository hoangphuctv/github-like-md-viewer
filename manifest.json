{
  "manifest_version": 3,
  "name": "GitHub-like Markdown Viewer",
  "version": "0.1.1",
  "description": "Render local Markdown files with a GitHub-like reading experience.",
  "content_scripts": [
    {
      "matches": ["file:///*.md", "file:///*.markdown", "file:///*.mdown", "file:///*.mkd"],
      "js": ["content.js"],
      "css": ["github-markdown.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}
